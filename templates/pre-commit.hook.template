# ── 1f. Build discipline (nguyên tắc 15 — nội hoá 2026-08-14, xem NOTICE.md) ──
# 1f-a: marker `nợ:` phải đủ 2 vế (trần, điều kiện nâng cấp) — chỉ soi DÒNG THÊM (15 §7)
# 1f-b: export function mới trùng tên với export sẵn có trong repo -> WARN (15 §3)
# 1f-c: page/screen mới có fetch mà thiếu nhánh loading/error TRONG CODE -> WARN
#       (dong lo "spec đủ ma trận nhưng code cắt state — design-verify chỉ lint SPEC", 15 §4)
# 1f-d: lane gate (can ui-lane.sh qua junction): page moi (status A) ma design-spec khong staged
#       -> BLOCK neu repo CO design-spec (WARN neu chua tung co — dung ep repo chua dung design flow);
#       diff qua to so voi lane (LANE1>200, LANE2>800 dong) -> WARN. Nguong tu backtest 40 commit.
if [ "$BUILD_CHECKS" != "off" ]; then
  # Loại .githooks/ + *.template khỏi scan dòng-thêm: chính hook/template chứa chuỗi fixture
  # mẫu marker — không phải nợ thật (tự bắt mình khi commit hook là WARN rác).
  BD_FILES=$(echo "$CHANGED" | grep -vE '^\.githooks/|\.template$' || true)
  ADDED=$(git diff --cached -U0 -- $BD_FILES 2>/dev/null | grep '^+' | grep -vE '^\+\+\+' || true)
  # 1f-a — nợ: hai vế (chấp nhận alias ASCII debt:)
  BADNO=$(echo "$ADDED" | grep -E '(//|#|--|<!--) *(nợ|debt):' | grep -vE '(nợ|debt):[^,]+,' || true)
  if [ -n "$BADNO" ]; then
    echo "WARN: marker no/debt thieu ve 2 (dieu kien nang cap) — format '// nợ: <tran>, <dieu kien nang cap>' (NT15 §7):"
    echo "$BADNO" | head -3 | sed 's/^/    /'
  fi
  # 1f-b — export trùng tên (staged-only; allowlist route handler + Next conventions)
  EXPORT_ALLOW='GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|middleware|default|generateMetadata|generateStaticParams|generateViewport'
  for f in $(echo "$CHANGED" | grep -E '\.(ts|tsx|js|jsx)$' || true); do
    NEWFN=$(git diff --cached -U0 -- "$f" 2>/dev/null | grep -E '^\+export (async )?function [A-Za-z_]' | sed -E 's/^\+export (async )?function ([A-Za-z_][A-Za-z0-9_]*).*/\2/' || true)
    for fn in $NEWFN; do
      echo "$fn" | grep -qE "^($EXPORT_ALLOW)$" && continue
      DUP=$(git grep -lE "export (async )?function $fn([^A-Za-z0-9_]|$)" -- '*.ts' '*.tsx' '*.js' '*.jsx' 2>/dev/null | grep -v "^$f$" | head -1)
      [ -n "$DUP" ] && echo "WARN: export function '$fn' moi trong $f trung ten voi $DUP — grep truoc khi them, dung lai hoac gop (NT15 §3)."
    done
  done
  # 1f-c — page fetch thiếu state (content HOẶC sibling loading/error đều được tính là đủ)
  for f in $(echo "$CHANGED" | grep -E '(page|screen)\.(tsx|jsx)$' || true); do
    PC=$(git show ":$f" 2>/dev/null) || continue
    echo "$PC" | grep -qE 'fetch\(|useEffect|useQuery|useSWR|supabase|axios' || continue
    D=$(dirname "$f")
    HASL=0; echo "$PC" | grep -qiE 'loading|skeleton|suspense|isPending|spinner|đang tải|dang tai' && HASL=1
    [ "$HASL" -eq 0 ] && { [ -f "$D/loading.tsx" ] || [ -f "$D/loading.jsx" ]; } && HASL=1
    HASE=0; echo "$PC" | grep -qiE 'error|catch|onError|thất bại|that bai|lỗi' && HASE=1
    [ "$HASE" -eq 0 ] && { [ -f "$D/error.tsx" ] || [ -f "$D/error.jsx" ]; } && HASE=1
    if [ "$HASL" -eq 0 ] || [ "$HASE" -eq 0 ]; then
      echo "WARN: $f co fetch nhung thieu nhanh $([ "$HASL" -eq 0 ] && printf 'loading ')$([ "$HASE" -eq 0 ] && printf 'error') trong code — ma tran trang thai phai SONG TRONG CODE, khong chi trong spec (NT15 §4; design-verify chi lint spec)."
    fi
  done
  # 1f-d — lane-vs-spec: KHONG can classifier (tu grep page moi) — chi diff-size can ui-lane.sh
  NS=$(git diff --cached --name-status 2>/dev/null)
  NEWPAGE=$(printf '%s\n' "$NS" | awk '$1=="A"{print $2}' | grep -E '(^|/)(page|layout|route)\.(tsx|jsx)$|(^|/)(pages|routes|screens|views)/[^/]*\.(tsx|jsx)$' || true)
  if [ -n "$NEWPAGE" ]; then
    SPEC_STAGED=$(printf '%s\n' "$NS" | awk '{print $2}' | grep -iE 'design-spec.*\.md$|DESIGN-SPEC\.md$' || true)
    if [ -z "$SPEC_STAGED" ]; then
      SPEC_EXISTS=$(git ls-files 2>/dev/null | grep -icE 'design-spec.*\.md$|DESIGN-SPEC\.md$' || true)
      if [ "${SPEC_EXISTS:-0}" -gt 0 ]; then
        echo "BLOCK: man hinh moi ($NEWPAGE) ma design-spec KHONG duoc cap nhat cung commit — screen map phai co dong TRUOC khi code (ui-design-logic 01 §8, NT15 §2)."
        FAIL=1
      else
        echo "WARN: man hinh moi ($NEWPAGE) va repo chua co design-spec nao — can nhac chay pipeline ui-design-logic buoc 1 (spec nho cho task nho van la spec)."
      fi
    fi
  fi
  UL=".claude/skills/ui-design-logic/ui-lane.sh"
  if [ -f "$UL" ]; then
    LANE=$(printf '%s\n' "$NS" | sh "$UL" --stdin 2>/dev/null | tail -1)
    if [ "$LANE" = "LANE1" ] || [ "$LANE" = "LANE2" ]; then
      DLINES=$(git diff --cached --numstat 2>/dev/null | awk '{a+=$1+$2} END{print a+0}')
      { [ "$LANE" = "LANE1" ] && [ "$DLINES" -gt 200 ]; } && echo "WARN: lane LANE1 (sua nho) nhung diff $DLINES dong (>200) — co dang refactor 'tien tay' ngoai pham vi? (NT15 §1; nguong tu backtest 40 commit)"
      { [ "$LANE" = "LANE2" ] && [ "$DLINES" -gt 800 ]; } && echo "WARN: lane LANE2 nhung diff $DLINES dong (>800) — can nhac tach lot/commit (NT15 §1)."
    fi
  fi
fi

# ── 1e. Security gate — secret-scan + doc prompt-injection lint (nguyên tắc 14) ──
# secret-scan: staged code/config chua secret HIGH-CONFIDENCE -> BLOCK (loai placeholder).
# doc-injection: docs/app-map/** + CLAUDE.md (input truc tiep vao AI) chua cau menh-lenh-huong-agent
#   -> BLOCK (LLM01 Prompt Injection). Docs untrusted-by-default: doc MO TA, KHONG RA LENH cho agent.
# Gioi han (trung thuc): regex high-confidence, KHONG phai taint/SAST that (do la CI point-to-tool);
#   chan commit MOI, KHONG cuu duoc secret da push (rotate + xoa lich su). SEC_CHECKS=off de tat.
if [ "$SEC_CHECKS" != "off" ]; then
  Q=$(printf '\047')
  SEC_PLACEHOLDER="your[-_]|xxx+|example|changeme|placeholder|dummy|redacted|<[a-zA-Z]|\{\{|process\.env|os\.environ|getenv|import\.meta\.env|ENV\[|secret_name|_here|fixture|mock|fake|sample"
  # v1.20.0 (audit trải nghiệm dev 2026-08-17, CO-1) — MIỄN TRỪ FILE TEST. Chặn oan đo được:
  # `const password = "hunter2hunter2hunter2"` trong `src/__tests__/auth.test.ts` bị gọi là
  # "secret HIGH-CONFIDENCE" kèm lời khuyên "ROTATE key + xoá lịch sử" — vô nghĩa với fixture, không
  # nêu đường thoát nào ⇒ chính ca đẩy dev sang `--no-verify`. Key THẬT trong file test vẫn nguy hiểm,
  # nên đây là WARN (vẫn nhìn thấy) chứ không phải bỏ qua hoàn toàn.
  SEC_TESTPATH='(^|/)(__tests__|__mocks__|tests?|spec|fixtures?)/|\.(test|spec)\.[a-z]+$|\.fixture\.'
  SECRET_LITERAL="(api[_-]?key|secret|token|passwd|password|client[_-]?secret|access[_-]?key)[\"$Q]?[[:space:]]*[:=][[:space:]]*[\"$Q][A-Za-z0-9_./+=-]{16,}[\"$Q]"
  SECRET_PAT="-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|sk_(live|test)_[0-9A-Za-z]{16,}|rk_live_[0-9A-Za-z]{16,}|glpat-[0-9A-Za-z_-]{20,}|sk-[A-Za-z0-9]{20,}|$SECRET_LITERAL"
  # A1 secret-scan — code/config staged; bo qua .template (chinh bo tool chua pattern lam vi du) + lockfile.
  # .md CO trong danh sach: docs la first-class input cua he, secret dan vao .md (API key trong docs) rat thuong gap;
  # pattern la high-confidence literal/prefix (loai placeholder) nen rui ro false-positive tren .md thap.
  # v1.20.0 (audit độc lập 2026-08-17, P0): allowlist theo ĐUÔI FILE để lọt secret thật — `.env.local`,
  # `.env.production`, `Dockerfile`, `.npmrc`, `.tf/.tfvars`, `Makefile` đều NGOÀI lưới (đo được:
  # cùng `sk_live_` trong .ts thì BLOCK, trong .env.local thì commit trót lọt). Nay thêm các họ đó
  # bằng match TÊN FILE (không chỉ đuôi). Vẫn loại .template/lockfile để không tự bắt fixture của hệ.
  for f in $(echo "$CHANGED" | grep -iE '(\.(js|jsx|ts|tsx|py|rb|go|java|php|cs|rs|c|cpp|env|json|ya?ml|sh|sql|txt|md|pem|key|cfg|conf|ini|properties|xml|toml|tf|tfvars|npmrc)$|(^|/)(\.env[^/]*|Dockerfile[^/]*|Makefile|\.npmrc)$)' | grep -vE '\.template$|package-lock|yarn\.lock|pnpm-lock' || true); do
    git cat-file -e ":$f" 2>/dev/null || continue
    HIT=$(git show ":$f" 2>/dev/null | grep -nE -e "$SECRET_PAT" | grep -viE -e "$SEC_PLACEHOLDER")
    if [ -n "$HIT" ]; then
      if echo "$f" | grep -qE "$SEC_TESTPATH"; then
        echo "WARN: chuoi giong secret trong FILE TEST $f — khong chan (fixture la viec binh thuong):"
        echo "$HIT" | head -2 | sed 's/^/    /'
        echo "  -> Neu la key THAT: van phai rotate + doi sang env, du nam trong test."
        echo "  -> Neu la fixture: dat ten co 'fixture/mock/fake/sample/placeholder' de het WARN."
      else
        echo "BLOCK: secret HIGH-CONFIDENCE trong $f (nguyen tac 14, LLM02/A02):"
        echo "$HIT" | head -3 | sed 's/^/    /'
        echo "  -> Neu la SECRET THAT: xoa khoi code + dua vao env/secret manager; da push thi ROTATE key + xoa lich su."
        echo "  -> Neu la FIXTURE/vi du: dat ten bien co 'placeholder|example|fixture|mock|fake|sample', hoac de trong file test (*.test.*, __tests__/)."
        echo "  -> Duong thoat cuoi (ca repo): SEC_CHECKS=off trong .githooks/pre-commit — TAT ca secret-scan, chi dung khi da hieu hau qua."
        FAIL=1
      fi
    fi
  done
  # A2 doc prompt-injection lint — chi docs duoc ROUTE (app-map + CLAUDE.md) = input truc tiep vao AI
  INJECT_BLOCK='ignore ([a-z]+ )*(previous|prior|above|all) (instruction|rule|prompt)|disregard ([a-z]+ )*(instruction|rule|context|prompt)|(forget|clear|wipe|reset) ([a-z]+ )*(previous|prior|above|all|everything) ([a-z]+ )*(instruction|rule|prompt|context)|(exfiltrat|leak|curl|upload)[a-z ]*(secret|token|credential|api.?key|password|env)|bỏ qua .*(chỉ dẫn|hướng dẫn|quy tắc) (trước|trên)|(quên|xoá|xóa) .*(chỉ dẫn|hướng dẫn|quy tắc|lệnh) (trước|trên|phía trên)'
  # Nhánh exfil-verb MỀM: send/post/fetch/email/transmit + secret-object chỉ BLOCK khi CÙNG DÒNG có
  # sink khả nghi (URL/webhook/attacker...) — prose mô tả hợp lệ "handler sends the auth token to the
  # Stripe provider" KHÔNG bị chặn oan (hội đồng T3: chặn oan đúng docs auth/payment mà review sống,
  # đẩy user sang SEC_CHECKS=off làm mù cả secret-scan).
  INJECT_EXFIL_SOFT='(send|post|fetch|email|transmit)[a-z ]*(secret|token|credential|api.?key|password|env)'
  INJECT_SINK='http|://|webhook|attacker|evil|bên thứ ba|copy (of|to)'
  INJECT_WARN='you (are|must) now [a-z]|system prompt|reveal .*(instruction|prompt|system)|(base64|\\x[0-9a-f]{2}[0-9a-f ]{20,})'
  # KHONG mien tru theo TEN FILE nua (dat ten *security-review* de ne = lo hong o chinh cong doc nhat cua he).
  # Thay vao do: chi lint DONG "TRAN" (bare) — payload trich lam VI DU phai nam trong code-fence ``` HOAC
  # blockquote '>' thi duoc mien. Ap dung cho MOI doc (ke ca security-review / threat-model / owasp): cau
  # menh-lenh TRAN ngoai fence VAN BLOCK du ten file la gi. Doi contract: muon trich payload -> fence/blockquote
  # no (xem methodology/14 §A2 + §Non-goals). Vua chan lo ne-theo-ten, vua het chan-oan doc mo ta injection.
  # v1.17.0 — MỞ SCOPE (finding của chính security-logic khi tự review repo, đã repro bằng hook thật:
  # payload đặt trong docs/app-map → BLOCK, đặt trong skills/*/SKILL.md hoặc .claude/commands → LỌT).
  # Mọi file NẠP THẲNG vào context agent đều là input untrusted: skill, command, subagent, AGENTS.md.
  # Nguy hiểm đặc thù: `init` tạo junction .claude/skills/* trỏ vào package → payload trong SKILL.md
  # đi theo publish xuống MỌI project tiêu thụ.
  for f in $(echo "$CHANGED" | grep -E '^(CLAUDE\.md|AGENTS\.md|docs/app-map/.*\.md|skills/.*\.md|\.claude/(commands|agents)/.*\.md)$' | grep -v '_generated/' || true); do
    git cat-file -e ":$f" 2>/dev/null || continue
    DC=$(git show ":$f" 2>/dev/null)
    # BARE = cac dong NGOAI code-fence va KHONG phai blockquote, giu so dong that (NR) de bao cao.
    BARE=$(echo "$DC" | awk '/^[[:space:]]*```/{fence=!fence; next} fence{next} /^[[:space:]]*>/{next} {print NR": "$0}')
    IB=$(echo "$BARE" | grep -iE "$INJECT_BLOCK")
    IB2=$(echo "$BARE" | grep -iE "$INJECT_EXFIL_SOFT" | grep -iE "$INJECT_SINK")
    [ -n "$IB2" ] && IB="$IB${IB:+
}$IB2"
    if [ -n "$IB" ]; then
      echo "BLOCK: cau menh-lenh-huong-agent trong doc '$f' (nguyen tac 14, LLM01 Prompt Injection):"
      echo "$IB" | head -3 | sed 's/^/    /'
      echo "  -> Doc phai MO TA (code lam gi/tai sao), KHONG RA LENH cho agent. Neu la VI DU/payload trich dan:"
      echo "     dat trong code-fence \`\`\` hoac blockquote '>' (ke ca trong security-review). Neu la lenh that: xoa."
      FAIL=1
    fi
    echo "$BARE" | grep -qiE "$INJECT_WARN" && echo "WARN: doc '$f' co pattern nghi injection (persona-override / system-prompt / encoded blob) — docs untrusted-by-default, ra soat (nguyen tac 14)."
  done
  # A3 (advisory): path nhay cam staged ma khong kem security-review -> WARN
  if echo "$CHANGED" | grep -qE "$SEC_SENSITIVE_PATHS"; then
    echo "$CHANGED" | grep -qiE 'security-review.*\.md$' || echo "WARN: commit cham path nhay cam (auth/payment/crypto/migration/.env) — can nhac security-review + tier RED (nguyen tac 14/06)."
  fi
fi

# ── 2. Root CLAUDE.md token budget ─────────────────────────────────────
# Ratchet: chỉ check khi CLAUDE.md nằm trong commit — vi phạm tồn đọng được "ân hạn"
# tới lần sửa kế tiếp (tránh hook fail mọi commit khi retrofit vào repo cũ).
# Đo BLOB ĐÃ STAGE (git show :CLAUDE.md), không đo working tree — tránh block/pass oan
# khi worktree khác staged. Guard cat-file: file đang bị staged-delete thì bỏ qua.
if echo "$CHANGED" | grep -qx 'CLAUDE.md'; then
  if git cat-file -e :CLAUDE.md 2>/dev/null; then
    SIZE=$(git show :CLAUDE.md | wc -c | tr -d ' ')
    if [ "$SIZE" -gt "$CLAUDE_MD_CHAR_BUDGET" ]; then
      echo "BLOCK: CLAUDE.md (staged) ${SIZE} chars > budget ${CLAUDE_MD_CHAR_BUDGET} (~6K tokens)."
      echo "  -> Tach bang/chi tiet ra docs/app-map/, root chi giu rule + pointer (nguyen tac 01 \"root diet\")."
      FAIL=1
    fi
  fi
fi

# ── 3. Schema dùng chung đổi → contract phải đổi cùng commit (nguyên tắc 10) ──
# Khai báo từng cặp schema→contract. Bỏ comment + sửa pattern cho mỗi schema chung.
check_contract() {
  if echo "$CHANGED" | grep -qE "$1"; then
    if ! echo "$CHANGED" | grep -qE "$2"; then
      echo "BLOCK: schema dung chung ($1) doi nhung contract ($2) khong update."
      echo "  -> Update contract (bump version neu breaking) roi commit lai."
      FAIL=1
    fi
  fi
}
# Ví dụ / example:
# check_contract 'modules/plan_writer\.py' 'docs/contracts/plan-json\.contract\.md'

# ── 3b. Encoding guard: BOM / mojibake trong file .md|.template đã stage ──
# Pattern build bằng printf octal — file hook KHÔNG được chứa literal mojibake, kể cả trong
# comment (sẽ tự bắt chính mình). Bắt 4 chữ ký double-encode phổ biến nhất khi UTF-8 bị đọc
# nhầm ANSI rồi ghi lại: dấu-a-hỏng x2, em-dash hỏng, chữ đ hỏng (bytes: C3A1C2BA, C3A1C2BB,
# C3A2E282AC, C384E28098). Tiếng Việt sạch (kể cả chữ hoa có dấu ngã) KHÔNG khớp các chuỗi này.
M1=$(printf '\303\241\302\272'); M2=$(printf '\303\241\302\273')
M3=$(printf '\303\242\342\202\254'); M4=$(printf '\303\204\342\200\230')
BOM=$(printf '\357\273\277')
for f in $(echo "$CHANGED" | grep -E '\.(md|template)$' || true); do
  git cat-file -e ":$f" 2>/dev/null || continue
  if git show ":$f" | head -c 3 | grep -q "$BOM"; then
    echo "BLOCK: $f bat dau bang UTF-8 BOM -> ghi lai khong BOM (PS 5.1 Set-Content them BOM, dung UTF8Encoding(false))."
    FAIL=1
  fi
  if git show ":$f" | grep -qE "$M1|$M2|$M3|$M4"; then
    echo "BLOCK: $f chua mojibake (UTF-8 bi doc nham ANSI roi ghi lai) -> restore tu git roi sua bang tool UTF-8 (sed/Edit), KHONG dung PS 5.1 Get/Set-Content."
    FAIL=1
  fi
done

# ── 3c. Consent NOTIFY vết-audit (v1.11.0 — ENFORCED phạm-vi-hẹp tại commit-time) ──
# Token-trong-staged-diff: so GIÁ TRỊ HIỆU LỰC (head -1, cùng phép chiếu cfg của triage-verify)
# staged vs HEAD. HEAD=off mà staged≠off (on hoặc VẮNG dòng) = gỡ phủ quyết repo → đòi dòng token
# MỚI trong staged diff. Cặp -/+ cùng giá trị (di-chuyển-dòng/churn-eol) không đổi hiệu lực → PASS.
# Nguồn không đọc được (unborn HEAD / file vắng, exit 128) := unset → không chặn (thêm-mới off là thu hẹp).
# Phạm-vi-hẹp: chỉ chặn commit THIẾU token — không chặn agent tự viết token (luật cấm đó là ADVISORY
# trong skills/ui-ux-triage/SKILL.md §8). Vai trò: vết audit trong lịch sử file + rào vô ý.
if echo "$CHANGED" | grep -q '^\.claude/triage\.config$'; then
  NH=$(git show HEAD:.claude/triage.config 2>/dev/null | grep -E '^NOTIFY=' | head -1 | sed -E 's/^NOTIFY=//; s/[[:space:]]+#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//')
  NS=$(git show :0:.claude/triage.config 2>/dev/null | grep -E '^NOTIFY=' | head -1 | sed -E 's/^NOTIFY=//; s/[[:space:]]+#.*$//; s/^[[:space:]]+//; s/[[:space:]]+$//')
  case "$NH" in on|off) ;; *) NH=unset;; esac
  case "$NS" in on|off) ;; *) NS=unset;; esac
  if [ "$NH" = "off" ] && [ "$NS" != "off" ]; then
    if ! git diff --cached -U0 -- .claude/triage.config 2>/dev/null | grep -q '^+# user-consent: notify-on'; then
      echo "BLOCK: staged go NOTIFY=off (hieu luc off -> $NS) ma THIEU dong token moi '# user-consent: notify-on <ngay>'."
      echo "  -> User dat dong token NGAY CANH thay doi NOTIFY trong .claude/triage.config, stage cung nhau. Moi lan flip THEM mot dong token MOI (kem ngay)."
      FAIL=1
    fi
  fi
fi

# ── 3d. Consent --config-check (DETECTED — ghi trạng thái consent vào triage-log, KHÔNG kéo FAIL hook) ──
# Guard tồn-tại-file theo mẫu design-verify ($DV): junction .claude/skills là per-machine bị auto-gitignore —
# fresh clone chưa `ai-simple init` không có verifier → skip im lặng, hook không gãy.
TV=".claude/skills/ui-ux-triage/triage-verify.sh"
if [ -f "$TV" ]; then sh "$TV" --config-check >/dev/null 2>&1 || true; fi

# ── 3e. Session-audit chưa đóng (DETECTED — WARN, KHÔNG kéo FAIL: "WARN là WARN") ──
# Phiên triage có dòng log FORMAT LOOP mới hơn record audit chính thức mới nhất = phiên chưa chạy
# pha ĐÓNG. BỎ QUA dòng 'consent |' của --config-check (user đổi consent không kèm phiên triage nào
# thì mọi commit 24h kế sẽ dính WARN oan).
TLOG="test-reports/triage/triage-log.md"
if [ -f "$TLOG" ]; then
  LASTLOOP=$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}' "$TLOG" 2>/dev/null | grep -v '^consent |' | tail -1 | cut -d' ' -f1 | tr -d '-')
  LASTREC=$(ls test-reports/triage/audit-2*.txt 2>/dev/null | sed 's/.*audit-//; s/T.*//' | sort | tail -1)
  if [ -n "$LASTLOOP" ] && { [ -z "$LASTREC" ] || [ "$LASTLOOP" -gt "$LASTREC" ] 2>/dev/null; }; then
    echo "WARN: phien triage ($LASTLOOP) chua co record session-audit dong (exit gate §9) -> chay: sh $TV --session-audit --close <id>"
  fi
fi

# ── 4. WARN (không chặn): app-map file thiếu chuẩn ────────────────────
for f in $(echo "$CHANGED" | grep -E 'docs/app-map/.*\.md$' | grep -v '_generated/' || true); do
  [ -f "$f" ] || continue
  if ! head -5 "$f" | grep -qiE 'load (khi|when)'; then
    echo "WARN: $f thieu dong 'Load khi/Load when' o dau file (nguyen tac 02)."
  fi
done

# ── 5. Regenerate doc-status (cổng đọc luôn fresh — meta-rot guard) ─────
# doc-status.md phải fresh theo COMMIT chứ không theo tuần; marker DOC-STATUS trong doc
# được --status quản lý (xem report). Chỉ stage doc-status.md — KHÔNG auto-stage doc khác.
if [ "$FAIL" -eq 0 ] && [ -f scripts/doc-health-report.sh ]; then
  sh scripts/doc-health-report.sh --status --fast >/dev/null 2>&1 || true
  [ -f docs/app-map/_generated/doc-status.md ] && git add docs/app-map/_generated/doc-status.md 2>/dev/null
fi

[ "$FAIL" -eq 1 ] && exit 1
exit 0
