#!/bin/sh
# ai-simple-version: 1.23.0
# pre-commit — Automated enforcement (nguyên tắc 08 / principle 08)
#
# CHẠY ĐƯỢC NGAY với default Supabase + Next.js. Sửa 3 biến CẤU HÌNH bên dưới cho project khác.
# (Works out of the box for Supabase defaults. Edit the 3 CONFIG vars for other stacks.)
#
# Cài đặt KHUYẾN NGHỊ — versioned, mọi máy/agent đều bị enforce (xem 08 §hard-rules):
#   mkdir -p .githooks
#   cp templates/pre-commit.hook.template .githooks/pre-commit
#   git config core.hooksPath .githooks
#   git add .githooks   (commit cùng repo — máy clone mới chỉ cần chạy lại dòng git config)
#
# Cách cũ (1 máy — KHÔNG khuyến nghị, drift quay lại): cp vào .git/hooks/pre-commit
#
# Sau khi sửa config, verify: sh .githooks/pre-commit --self-test

# ── CẤU HÌNH / CONFIG — sửa theo project ──────────────────────────────
MIGRATIONS_PATTERN='supabase/migrations/.*\.sql$'         # prisma/migrations/.* | db/migrate/.* ...
DB_DOC_PATTERN='docs/.*(database|db|schema).*\.md$'       # doc nào được tính là "doc database"
CLAUDE_MD_CHAR_BUDGET=24000                               # ~6K tokens (EN ~4 chars/token; VN-heavy có thể hạ 20000)
CLAIMS_CHECK=auto                                         # auto | off — NT13 claim gate: auto = chỉ chạy khi registry tồn tại
UI_CHECKS=auto                                            # auto | on | off — anti-slop UI gate (ui-design-logic 07 §5): auto = chỉ chạy khi repo có tailwind.config.*/globals.css
BA_CHECKS=auto                                            # auto | off — cổng ba-spec (ba-verify --staged qua junction). auto = bật khi junction tồn tại
SEC_CHECKS=auto                                           # auto | off — nguyên tắc 14: secret-scan (BLOCK) + doc prompt-injection lint (BLOCK/WARN). auto = luôn bật (bảo mật là default-on)
BUILD_CHECKS=auto                                         # auto | off — nguyên tắc 15 build discipline: nợ-marker 2 vế, export trùng, page thiếu state, lane-vs-spec, diff-size-vs-lane
SEC_SENSITIVE_PATHS='(^|/)(auth|payment|billing|crypto|secrets?)(/|$)|\.env|migrations?/|(permission|rls|policy)'  # path nhạy cảm → WARN nhắc security-review (advisory)
# Sample paths cho --self-test — đổi CÙNG LÚC với 2 pattern trên:
SELF_TEST_MIGRATION_SAMPLE='supabase/migrations/0001_sample.sql'
SELF_TEST_DOC_SAMPLE='docs/app-map/03-database-and-automation.md'

# v1.20.0 (audit độc lập 2026-08-17) — MATCHER KHÔNG FORK. Đo thật trên repo cỡ ForFish (70 covers
# path): fork-per-path = 67.8s (967ms/path) vs case builtin = 0.67s (9.6ms/path) → 100×. Covers-sync
# chiếm 80% thời gian hook (127s/158s) nên ĐÂY là nút thắt thật — bản vá v1.19.0 nhắm doc-health (11%)
# vì attribution sai. Contract giữ nguyên: anchored — src/lib KHÔNG khớp src/lib-utils.
NL=$(printf '\nx'); NL=${NL%x}
covers_hit() {   # $1 = covers path; đọc $CHANGED_NL (global). Builtin — không spawn process nào.
  case "$CHANGED_NL" in
    *"$NL$1$NL"*) return 0;;
    *"$NL$1/"*)   return 0;;
  esac
  return 1
}

if [ "$1" = "--self-test" ]; then
  echo "ok: hook parse duoc."
  RC=0
  if echo "$SELF_TEST_MIGRATION_SAMPLE" | grep -qE "$MIGRATIONS_PATTERN" 2>/dev/null; then
    echo "PASS: MIGRATIONS_PATTERN khop '$SELF_TEST_MIGRATION_SAMPLE'"
  else
    echo "FAIL: MIGRATIONS_PATTERN KHONG khop sample (pattern sai hoac ERE invalid) -> check 1 se silent no-op!"
    RC=1
  fi
  if echo "$SELF_TEST_DOC_SAMPLE" | grep -qiE "$DB_DOC_PATTERN" 2>/dev/null; then
    echo "PASS: DB_DOC_PATTERN khop '$SELF_TEST_DOC_SAMPLE'"
  else
    echo "FAIL: DB_DOC_PATTERN KHONG khop sample -> moi migration commit se bi block oan!"
    RC=1
  fi
  echo "  BUDGET = $CLAUDE_MD_CHAR_BUDGET chars"
  # Contract test matcher (CÙNG bảng với doc-health-report self-test — matcher tồn tại
  # ở 2 file, bảng này là hợp đồng chung, nguyên tắc 10 áp cho nội bộ hệ):
  CHANGED_NL="${NL}src/lib-utils/a.ts${NL}"; M=""; covers_hit "src/lib" && M=1
  [ -z "$M" ] && echo "PASS: matcher contract — sibling (src/lib-utils) KHONG khop src/lib" || { echo "FAIL: matcher overmatch sibling"; RC=1; }
  CHANGED_NL="${NL}src/lib/x.ts${NL}"; M=""; covers_hit "src/lib" && M=1
  [ -n "$M" ] && echo "PASS: matcher contract — child (src/lib/x) khop" || { echo "FAIL: matcher miss child"; RC=1; }
  # Fixture gate: warn — chạy flow thật trong temp repo, WARN nhưng KHÔNG chặn
  HOOK_SELF="$0"; case "$HOOK_SELF" in /*|[A-Za-z]:*) ;; *) HOOK_SELF="$(pwd)/$HOOK_SELF";; esac
  # Wave 2b — 9 khối fixture là các temp repo ĐỘC LẬP, chi phí là spawn-bound (đo: 1 lượt hook ≈ 1.4s,
  # ~42 external spawn, KHÔNG có hotspot đơn lẻ; 4 lượt tuần tự 5.76s vs song song 2.83s).
  # → chạy song song, mỗi khối ghi log riêng; sau `wait` in log THEO ĐÚNG THỨ TỰ CŨ (output ổn định).
  # Verdict lấy từ log: dòng bắt đầu '^FAIL' (RC=1 trong subshell không propagate — đây là nguồn chân lý),
  # cộng ca subshell thoát sớm (mktemp guard) được ghi FAIL vào chính log của nó.
  OPW=$(pwd); PJ=$(mktemp -d) || exit 1
  ( TW=$(mktemp -d) || exit 1
  cd "$TW" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src/w docs/app-map
  cp "$HOOK_SELF" .githooks/pre-commit && chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
  echo "a" > src/w/a.ts
  printf '# w\n> Load khi: t\ncovers: src/w\ngate: warn\nlast_verified: 2026-01-01\nttl_days: 90\n' > docs/app-map/01-w.md
  git add -A && git commit -qm setup >/dev/null 2>&1
  echo "b" >> src/w/a.ts && git add src/w/a.ts
  OUTW=$(git commit -m warntest 2>&1); RCW=$?
  if [ "$RCW" -eq 0 ] && echo "$OUTW" | grep -q "WARN: code trong vung covers"; then
    echo "PASS: gate: warn -> chi WARN, khong chan commit"
  else
    echo "FAIL: gate warn khong dung (exit=$RCW)"; RC=1
  fi
  cd "$OPW" && rm -rf "$TW" ) > "$PJ/01.log" 2>&1 || echo "FAIL: khoi 01 thoat som" >> "$PJ/01.log" &
  # Fixture claim gate (NT13): claim cua BRANCH KHAC giu src/c -> commit dung vao bi BLOCK;
  # commit tu CHINH branch cua lot -> di qua.
  ( TC=$(mktemp -d) && cd "$TC" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src/c
  cp "$HOOK_SELF" .githooks/pre-commit && chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
  echo x > src/c/h.ts && git add -A && git commit -qm setup >/dev/null 2>&1
  CDT="$(git rev-parse --git-common-dir)/ai-simple/claims"; mkdir -p "$CDT"
  printf '{\n  "run": "r1",\n  "lot": "other",\n  "branch": "lot/r1/other",\n  "status": "ACTIVE",\n  "write_paths": [\n    "src/c"\n  ]\n}\n' > "$CDT/r1--other.json"
  echo y >> src/c/h.ts && git add src/c/h.ts
  OUTC=$(git commit -m claimtest 2>&1); RCC=$?
  if [ "$RCC" -ne 0 ] && echo "$OUTC" | grep -q "write-set cua claim khac"; then
    echo "PASS: claim gate chan staged path thuoc lot khac (NT13)"
  else
    echo "FAIL: claim gate khong chan (exit=$RCC)"; RC=1
  fi
  git checkout -qb lot/r1/other 2>/dev/null
  OUTC2=$(git commit -m ownlot 2>&1); RCC2=$?
  if [ "$RCC2" -eq 0 ]; then
    echo "PASS: claim gate cho phep chinh branch cua lot"
  else
    echo "FAIL: claim gate chan oan chinh lot (exit=$RCC2)"; RC=1
  fi
  cd "$OPW" && rm -rf "$TC" ) > "$PJ/02.log" 2>&1 || echo "FAIL: khoi 02 thoat som" >> "$PJ/02.log" &
  # Fixture UI anti-slop gate (1d): mau hard-code -> BLOCK; mau token -> qua
  ( TU=$(mktemp -d) && cd "$TU" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src/ui
  cp "$HOOK_SELF" .githooks/pre-commit && chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
  echo "module.exports={}" > tailwind.config.js
  git add -A && git commit -qm setup >/dev/null 2>&1
  printf 'export const A = () => <div className="text-[#ff0000]">x</div>\n' > src/ui/Bad.tsx
  git add src/ui/Bad.tsx
  OUTU=$(git commit -m uitest 2>&1); RCU=$?
  if [ "$RCU" -ne 0 ] && echo "$OUTU" | grep -q "mau hard-code"; then
    echo "PASS: UI gate chan mau hard-code (text-[#...])"
  else
    echo "FAIL: UI gate khong chan mau hard-code (exit=$RCU)"; RC=1
  fi
  printf 'export const A = () => <div className="text-primary">x</div>\n' > src/ui/Bad.tsx
  git add src/ui/Bad.tsx
  OUTU2=$(git commit -m uiok 2>&1); RCU2=$?
  [ "$RCU2" -eq 0 ] && echo "PASS: UI gate cho qua mau token" || { echo "FAIL: UI gate chan oan mau token (exit=$RCU2)"; RC=1; }
  # 1d moi: mau ham rgba trong arbitrary -> BLOCK (kenh lot cua gate hex)
  printf 'export const B = () => <div className="shadow-[0_10px_24px_-8px_rgba(16,42,67,0.28)]">x</div>\n' > src/ui/Sh.tsx
  git add src/ui/Sh.tsx
  OUTU3=$(git commit -m uirgba 2>&1); RCU3=$?
  if [ "$RCU3" -ne 0 ] && echo "$OUTU3" | grep -q "mau ham (rgba/hsla)"; then
    echo "PASS: UI gate chan rgba hard-code trong arbitrary class"
  else
    echo "FAIL: UI gate khong chan rgba arbitrary (exit=$RCU3)"; RC=1
  fi
  git reset -q HEAD src/ui/Sh.tsx && rm -f src/ui/Sh.tsx
  # 1d moi: type-ramp khai trong design-system doc -> text-[...] ngoai ramp WARN, trong ramp im;
  # min-h-[2.75rem] (touch target 44px) KHONG duoc dinh dan (bai hoc grep-blanket cua hoi dong)
  mkdir -p docs/app-map
  printf '# ds\ntype-ramp: 0.875rem 1rem 1.125rem\n' > docs/app-map/09-design-system.md
  git add docs/app-map/09-design-system.md && git commit -qm ds >/dev/null 2>&1
  printf 'export const C = () => <div className="text-[1.3rem] text-[1rem] min-h-[2.75rem]">x</div>\n' > src/ui/Ty.tsx
  git add src/ui/Ty.tsx
  OUTU4=$(git commit -m uiramp 2>&1); RCU4=$?
  if [ "$RCU4" -eq 0 ] && echo "$OUTU4" | grep -q "text-\[1.3rem\]' ngoai type-ramp" && ! echo "$OUTU4" | grep -q "text-\[1rem\]' ngoai" && ! echo "$OUTU4" | grep -q "min-h"; then
    echo "PASS: ramp gate WARN dung bac la, im voi bac hop le + khong dinh min-h touch target"
  else
    echo "FAIL: ramp gate sai hanh vi (exit=$RCU4): $OUTU4"; RC=1
  fi
  # F1/F2 — 1d-e focus ring: huy trang -> BLOCK; huy + focus-visible:ring-2 cung dong -> PASS
  printf 'export const F = () => <button className="outline-none px-2">x</button>\n' > src/ui/Fc.tsx
  git add src/ui/Fc.tsx
  OUTU5=$(git commit -m f1 2>&1); RCU5=$?
  if [ "$RCU5" -ne 0 ] && echo "$OUTU5" | grep -q "huy focus ring"; then echo "PASS: 1d-e BLOCK outline-none tran"
  else echo "FAIL: 1d-e khong chan outline-none tran (exit=$RCU5)"; RC=1; fi
  printf 'export const F = () => <button className="outline-none focus-visible:ring-2 px-2">x</button>\n' > src/ui/Fc.tsx
  git add src/ui/Fc.tsx
  OUTU6=$(git commit -m f2 2>&1); RCU6=$?
  if [ "$RCU6" -eq 0 ]; then echo "PASS: 1d-e cho qua outline-none + focus-visible:ring (fixture quan trong nhat)"
  else echo "FAIL: 1d-e chan oan pattern hop le (exit=$RCU6): $OUTU6"; RC=1; fi
  # F3 — 1d-f: onClick tren div khong role -> BLOCK; co role -> qua
  printf 'export const D = () => <div onClick={()=>1}>x</div>\n' > src/ui/Dv.tsx
  git add src/ui/Dv.tsx
  OUTU7=$(git commit -m f3 2>&1); RCU7=$?
  if [ "$RCU7" -ne 0 ] && echo "$OUTU7" | grep -q "onClick tren div"; then echo "PASS: 1d-f BLOCK onClick tren div tran"
  else echo "FAIL: 1d-f khong chan (exit=$RCU7)"; RC=1; fi
  printf 'export const D = () => <div role="button" tabIndex={0} onClick={()=>1}>x</div>\n' > src/ui/Dv.tsx
  git add src/ui/Dv.tsx
  OUTU8=$(git commit -m f3b 2>&1); RCU8=$?
  [ "$RCU8" -eq 0 ] && echo "PASS: 1d-f cho qua div co role" || { echo "FAIL: 1d-f chan oan div co role (exit=$RCU8)"; RC=1; }
  cd "$OPW" && rm -rf "$TU" ) > "$PJ/03.log" 2>&1 || echo "FAIL: khoi 03 thoat som" >> "$PJ/03.log" &
  # Wave 2b — nửa sau của fixture UI tách thành khối RIÊNG: khối 03 từng là critical path 50s
  # (đo mtime log/khối), chia đôi đưa tổng suite xuống dưới KPI <60s. Repo temp độc lập, cùng setup.
  ( TU2=$(mktemp -d) && cd "$TU2" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src/ui
  cp "$HOOK_SELF" .githooks/pre-commit && chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
  echo "module.exports={}" > tailwind.config.js
  git add -A && git commit -qm setup >/dev/null 2>&1
  # F4 — 1d-g: bg-clip-text MOT MINH -> qua (mat na anh); + text-transparent -> BLOCK
  printf 'export const G = () => <span className="bg-clip-text bg-[url(/x.png)]">x</span>\n' > src/ui/Gr.tsx
  git add src/ui/Gr.tsx
  OUTU9=$(git commit -m f4a 2>&1); RCU9=$?
  [ "$RCU9" -eq 0 ] && echo "PASS: 1d-g khong bat bg-clip-text mot minh" || { echo "FAIL: 1d-g bat oan mat na anh (exit=$RCU9)"; RC=1; }
  printf 'export const G = () => <span className="bg-clip-text text-transparent bg-gradient-to-r">x</span>\n' > src/ui/Gr.tsx
  git add src/ui/Gr.tsx
  OUTU10=$(git commit -m f4b 2>&1); RCU10=$?
  if [ "$RCU10" -ne 0 ] && echo "$OUTU10" | grep -q "gradient to len chu"; then echo "PASS: 1d-g BLOCK gradient tren chu"
  else echo "FAIL: 1d-g khong chan gradient chu (exit=$RCU10)"; RC=1; fi
  git reset -q HEAD src/ui/Gr.tsx 2>/dev/null; rm -f src/ui/Gr.tsx
  # F5 — 1d-h glow (shadow offset 0, dung var() de tranh gate mau) + 1d-i tracking vuot san
  printf 'export const H = () => <div className="shadow-[0_0_20px_var(--accent)] tracking-[-0.05em]">x</div>\n' > src/ui/Gl.tsx
  git add src/ui/Gl.tsx
  OUTU11=$(git commit -m f5 2>&1); RCU11=$?
  if [ "$RCU11" -ne 0 ] && echo "$OUTU11" | grep -q "glow (shadow offset 0)" && echo "$OUTU11" | grep -q "letter-spacing am vuot san"; then
    echo "PASS: 1d-h BLOCK glow + 1d-i BLOCK tracking vuot san"
  else echo "FAIL: 1d-h/1d-i sai (exit=$RCU11): $OUTU11"; RC=1; fi
  git reset -q HEAD src/ui/Gl.tsx 2>/dev/null; rm -f src/ui/Gl.tsx
  # 1d-p — globals.css thieu ::selection/caret -> WARN, khong chan
  mkdir -p src/app
  printf ':root{--x:1}\nbody{margin:0}\n' > src/app/globals.css
  git add src/app/globals.css
  OUTU12=$(git commit -m f6p 2>&1); RCU12=$?
  if [ "$RCU12" -eq 0 ] && echo "$OUTU12" | grep -q "thieu be mat trinh duyet"; then echo "PASS: 1d-p WARN globals thieu ::selection/caret, khong chan"
  else echo "FAIL: 1d-p sai (exit=$RCU12): $OUTU12"; RC=1; fi
  cd "$OPW" && rm -rf "$TU2" ) > "$PJ/10.log" 2>&1 || echo "FAIL: khoi 10 thoat som" >> "$PJ/10.log" &
  # 1f (NT15): no-marker 2 ve, export trung, page thieu state, lane-vs-spec — moi WARN khong duoc keo FAIL
  ( TB=$(mktemp -d) && cd "$TB" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src/lib src/app/foo docs/app-map
  cp "$HOOK_SELF" .githooks/pre-commit && chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
  printf 'export function dupFn(a){return a}\n' > src/lib/a.ts
  printf '# ds\n> Load khi: t\ncovers: src/app\ngate: warn\nlast_verified: 2026-01-01\nttl_days: 90\n## Thang người dùng\n| a |\n|---|\n| b |\n## Screen map\n| # | Màn | Vào từ | User đến để làm gì | Step tiếp theo | Primary |\n|---|---|---|---|---|---|\n| 1 | X | login | làm | xong | Tạo |\n## Ma trận trạng thái\n| a |\n|---|\n| b |\n' > docs/app-map/07-design-spec.md
  git add -A && git commit -qm setup >/dev/null 2>&1
  # F7: no-marker thieu ve 2 -> WARN nhung commit VAN QUA (khong keo FAIL)
  printf '// nợ: chỉ đỡ 100 dòng đầu\nexport const a=1\n' > src/lib/no1.ts
  git add src/lib/no1.ts
  OUTB=$(git commit -m no1 2>&1); RCB=$?
  if [ "$RCB" -eq 0 ] && echo "$OUTB" | grep -q "thieu ve 2"; then echo "PASS: 1f-a WARN no-marker thieu ve, khong chan"
  else echo "FAIL: 1f-a sai (exit=$RCB)"; RC=1; fi
  printf '// nợ: chỉ đỡ 100 dòng, phân trang khi list >100\nexport const b=1\n' > src/lib/no2.ts
  git add src/lib/no2.ts
  OUTB2=$(git commit -m no2 2>&1); RCB2=$?
  if [ "$RCB2" -eq 0 ] && ! echo "$OUTB2" | grep -q "thieu ve 2"; then echo "PASS: 1f-a im voi no-marker du 2 ve"
  else echo "FAIL: 1f-a bat oan marker du ve (exit=$RCB2)"; RC=1; fi
  # 1f-b: export function trung ten -> WARN, khong chan
  printf 'export function dupFn(b){return b}\n' > src/lib/b.ts
  git add src/lib/b.ts
  OUTB3=$(git commit -m dup 2>&1); RCB3=$?
  if [ "$RCB3" -eq 0 ] && echo "$OUTB3" | grep -q "trung ten voi"; then echo "PASS: 1f-b WARN export trung ten"
  else echo "FAIL: 1f-b khong WARN export trung (exit=$RCB3)"; RC=1; fi
  # F8 + lane-vs-spec: page MOI co fetch, khong loading/error, spec KHONG staged -> BLOCK (repo co spec)
  printf 'export default async function P(){const r=await fetch("/api/x");return <div>{String(r)}</div>}\n' > src/app/foo/page.tsx
  git add src/app/foo/page.tsx
  OUTB4=$(git commit -m page 2>&1); RCB4=$?
  if [ "$RCB4" -ne 0 ] && echo "$OUTB4" | grep -q "design-spec KHONG duoc cap nhat" && echo "$OUTB4" | grep -q "thieu nhanh"; then
    echo "PASS: 1f-d BLOCK page moi khong spec + 1f-c WARN thieu loading/error"
  else echo "FAIL: 1f-c/1f-d sai (exit=$RCB4): $OUTB4"; RC=1; fi
  # stage kem spec + du state -> qua
  printf 'export default async function P(){try{const r=await fetch("/api/x");return <div>{String(r)}</div>}catch(e){return <div>lỗi</div>}}\nexport const loading=1\n' > src/app/foo/page.tsx
  printf '| 2 | Foo | nav | xem foo | quay lai | (khong) |\n' >> docs/app-map/07-design-spec.md
  git add src/app/foo/page.tsx docs/app-map/07-design-spec.md
  OUTB5=$(git commit -m page2 2>&1); RCB5=$?
  if [ "$RCB5" -eq 0 ]; then echo "PASS: 1f page moi + spec cung commit + du state -> qua"
  else echo "FAIL: 1f chan oan khi da du (exit=$RCB5): $OUTB5"; RC=1; fi
  cd "$OPW" && rm -rf "$TB" ) > "$PJ/04.log" 2>&1 || echo "FAIL: khoi 04 thoat som" >> "$PJ/04.log" &
  # 1b moi: gate: warn nam SAU dong 10 nhung trong frontmatter (truoc heading ## dau) -> van WARN, khong BLOCK
  ( TG=$(mktemp -d) && cd "$TG" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src/g docs/app-map
  cp "$HOOK_SELF" .githooks/pre-commit && chmod +x .githooks/pre-commit && git config core.hooksPath .githooks
  echo "a" > src/g/a.ts
  { printf '# g\n> Load khi: t\ncovers: src/g\nlast_verified: 2026-01-01\n'
    i=0; while [ $i -lt 12 ]; do printf '<!-- re-verified: 2026-01-0%s - claim dai -->\n' "$((i%9+1))"; i=$((i+1)); done
    printf 'ttl_days: 90\ngate: warn\n\n## Noi dung\nx\n'; } > docs/app-map/01-g.md
  git add -A && git commit -qm setup >/dev/null 2>&1
  echo "b" >> src/g/a.ts && git add src/g/a.ts
  OUTG=$(git commit -m gatetest 2>&1); RCG=$?
  if [ "$RCG" -eq 0 ] && echo "$OUTG" | grep -q "WARN: code trong vung covers"; then
    echo "PASS: gate: warn sau dong 10 (frontmatter dai) van duoc doc — het nuot head-10"
  else
    echo "FAIL: gate: warn sau dong 10 bi nuot -> BLOCK oan (exit=$RCG)"; RC=1
  fi
  cd "$OPW" && rm -rf "$TG" ) > "$PJ/05.log" 2>&1 || echo "FAIL: khoi 05 thoat som" >> "$PJ/05.log" &
  # Fixture Security gate (1e): secret hard-code -> BLOCK; placeholder -> qua; doc injection -> BLOCK
  ( TS=$(mktemp -d) && cd "$TS" && git init -q . && git config user.email t@t.t && git config user.name t || exit 1
  mkdir -p .githooks src docs/app-map
