  printf '# e\n> Load khi: t\ncovers:\nlast_verified: 2026-01-01\nttl_days: 90\n' > docs/app-map/02-e.md; git add -A
  O20E=$(git commit -m emptycovers 2>&1); RC20E=$?
  if echo "$O20E" | grep -q 'KHONG parse ra path nao'; then echo "PASS: 1.20 — covers rong -> WARN tuong minh (khong tat cong im lang)"; else echo "FAIL: 1.20 covers rong im lang (exit=$RC20E)"; RC=1; fi
  # dọn staged của 2 ca BLOCK phía trên để ca chống-oan này không thừa hưởng chúng
  git reset -q HEAD . 2>/dev/null; git checkout -q -- src/orders/a.ts 2>/dev/null; rm -f docs/app-map/02-e.md
  printf '.btn:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--focus); }\n' > src/app.css 2>/dev/null || true
  mkdir -p src/ui && printf 'export const B = () => <button className="focus-visible:ring-2 outline-none">x</button>\n' > src/ui/Ok.tsx
  git add src/app.css src/ui/Ok.tsx
  O20F=$(git commit -m focusok 2>&1); RC20F=$?
  [ "$RC20F" -eq 0 ] && echo "PASS: 1.20 — focus-visible:ring + outline-none -> khong chan oan" || { echo "FAIL: 1.20 chan oan focus hop le (exit=$RC20F)"; RC=1; }
  cd "$OPW" && rm -rf "$TA20" ) > "$PJ/13.log" 2>&1 || echo "FAIL: khoi 13 thoat som" >> "$PJ/13.log" &
  wait
  # In log THEO THỨ TỰ CỐ ĐỊNH (không theo thứ tự hoàn thành) → output ổn định, so diff được giữa các lần chạy.
  for i in 01 02 03 04 05 06 07 08 09 10 11 12 13; do
    if [ -s "$PJ/$i.log" ]; then cat "$PJ/$i.log"
    else echo "FAIL: khoi $i khong sinh output (subshell chet im lang?)"; RC=1; fi
  done
  # Verdict của phần song song: dòng '^FAIL' trong log là NGUỒN CHÂN LÝ (RC=1 trong subshell không propagate).
  grep -hq '^FAIL' "$PJ"/*.log 2>/dev/null && RC=1
  rm -rf "$PJ"
  exit $RC
fi

CHANGED=$(git -c core.quotepath=false diff --cached --name-only)
FAIL=0
# v1.20.0 (audit độc lập 2026-08-17) — MATCHER KHÔNG FORK. Đo thật trên repo cỡ ForFish (19 doc,
# 70 covers path): `H=$(echo "$CHANGED" | while read ...)` fork một subshell CHO TỪNG path →
# 67.8s (967ms/path); `case` builtin trên cùng dữ liệu = 0.67s (9.6ms/path) → **100×**. Covers-sync
# chiếm 80% thời gian hook (127s/158s) nên đây là nút thắt thật; bản vá v1.19.0 nhắm doc-health
# (11%) vì attribution sai. Contract giữ nguyên: anchored — src/lib KHÔNG khớp src/lib-utils.
CHANGED_NL="$NL$CHANGED$NL"
# Wave 2a [ENFORCED — space-safe]: word-split theo NEWLINE-only cho TOÀN BỘ vòng duyệt filename
# của gate (8 vòng `for f in $(...)`): tên file có DẤU CÁCH không còn bị tách đôi → skip im lặng.
# An toàn vì mọi for-loop trong hook đều duyệt dữ liệu newline-separated hoặc glob (đã kiểm từng vòng
# + grep 0 lệnh dựa unquoted-space-split); quotepath=false để tên tiếng Việt không bị git escape.
IFS=$(printf '\nx'); IFS=${IFS%x}

# ── 1. Migration đổi → doc database phải đổi cùng commit ──────────────
if echo "$CHANGED" | grep -qE "$MIGRATIONS_PATTERN"; then
  if ! echo "$CHANGED" | grep -qiE "$DB_DOC_PATTERN"; then
    echo "BLOCK: migration thay doi nhung doc database khong update."
    echo "  -> Update docs/app-map/*database*.md (hoac regenerate _generated/schema.md) roi commit lai."
    FAIL=1
  fi
fi

# ── 1b. Covers-sync — CỔNG GHI của nguyên tắc 12 v2 ─────────────────────
# Code đổi trong vùng `covers:` của doc nào -> doc đó PHẢI được sửa hoặc bump
# `last_verified:` trong CÙNG commit. Bump = cam kết "tôi đã đối chiếu, nội dung vẫn đúng"
# — commit message bump phải ghi re-verify(<doc>): <claims đã check> để audit spot-check được.
# SEMANTICS covers (thống nhất với doc-health-report): mỗi entry là FILE hoặc DIR CÓ THẬT;
# match = đúng path đó hoặc mọi thứ bên dưới nó ($p hoặc $p/*) — anchored, không phải prefix
# chuỗi (src/lib KHÔNG khớp src/lib-utils). Tuỳ chọn frontmatter `gate: warn` để hạ xuống
# cảnh báo cho vùng code churn cao (mặc định: block).
for doc in $(git ls-files 'docs/app-map/*.md' 'docs/app-map/**/*.md' 2>/dev/null | grep -v '_generated/' | sort -u); do
  [ -f "$doc" ] || continue
  # Frontmatter = từ đầu file tới heading `## ` đầu tiên (cap 400 dòng) — KHÔNG head -10:
  # doc thật có comment re-verified dài đẩy `gate: warn` xuống sâu (ForFish 02-architecture ~:248),
  # head -10 nuốt mất gate trong im lặng -> doc bị xử BLOCK dù đã khai warn (hội đồng 2026-08-13).
  FM=$(awk 'NR>400{exit} /^## /{exit} {print}' "$doc")
  CLINE=$(echo "$FM" | grep -i '^covers:' | head -1)
  [ -n "$CLINE" ] || continue
  GATE=$(echo "$FM" | grep -i '^gate:' | head -1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d ' ')
  # v1.20.0 (audit độc lập 2026-08-17, P0) — CỔNG FLAGSHIP TỪNG FAIL-OPEN IM LẶNG: `covers:` dạng
  # YAML LIST (dạng tự nhiên nhất) cho giá trị rỗng ⇒ HIT=0 ⇒ cổng TẮT, không BLOCK, không cả WARN.
  # Nay đọc CẢ HAI dạng: inline (`covers: a, b`) và list (`covers:` + các dòng `  - a`); và nếu vẫn
  # không parse ra path nào thì WARN TƯỜNG MINH thay vì im lặng — "an-toàn-giả là lỗ hổng".
  CPATHS_DOC=$(echo "$CLINE" | sed 's/^[Cc]overs:[[:space:]]*//' | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$')
  if [ -z "$CPATHS_DOC" ]; then
    CPATHS_DOC=$(echo "$FM" | awk 'tolower($0) ~ /^covers:/ {f=1; next} f && /^[[:space:]]*-[[:space:]]*/ {sub(/^[[:space:]]*-[[:space:]]*/,""); gsub(/[[:space:]]+$/,""); if ($0 != "") print; next} f && /^[^[:space:]]/ {exit}')
  fi
  if [ -z "$CPATHS_DOC" ]; then
    echo "WARN: '$doc' co dong 'covers:' nhung KHONG parse ra path nao — cong covers-sync DANG TAT cho doc nay."
    echo "  -> Dung 'covers: src/a, src/b' (inline) hoac YAML list ('covers:' roi cac dong '  - src/a')."
    continue
  fi
  HIT=0
  for p in $CPATHS_DOC; do
    [ -n "$p" ] || continue
    covers_hit "$p" && { HIT=1; break; }
  done
  # "Doc da duoc sua" = co it nhat 1 dong staged-diff KHONG phai marker DOC-STATUS may-ghi.
  # Neu khong loai marker: hook ghi DOC-STATUS vao working tree o buoc 5 -> lan commit sau
  # `git add -A` stage dong may-ghi do -> cong covers tuong "doc da sua" -> FALSE-PASS he thong
  # (hoi dong Fable B1/M4: demo First-win cua README fail vi chinh ke nay).
  DOCMOD=0
  if echo "$CHANGED" | grep -qx "$doc"; then
    REAL=$(git diff --cached -U0 -- "$doc" 2>/dev/null | grep -E '^[+-][^+-]' | grep -v 'DOC-STATUS')
    [ -n "$REAL" ] && DOCMOD=1
  fi
  if [ "$HIT" -eq 1 ] && [ "$DOCMOD" -eq 0 ]; then
    if [ "$GATE" = "warn" ]; then
      echo "WARN: code trong vung covers cua '$doc' thay doi, doc chua duoc sua/re-verify (gate: warn)."
    else
      echo "BLOCK: code trong vung covers cua '$doc' thay doi nhung doc khong duoc sua/re-verify."
      echo "  -> Sua noi dung; hoac da doi chieu thay van dung thi: bump 'last_verified:' + them dong"
      echo "     <!-- re-verified: <date time> - <claims da check> --> (luon tao thay doi staged, ke ca re-verify cung ngay)"
      echo "     va commit msg: re-verify($doc): <claims>. Roi commit lai."
      echo "     (Luu y: dong DOC-STATUS may-ghi bi stage kem KHONG duoc tinh la 'da sua doc'.)"
      FAIL=1
    fi
  fi
done

# ── 1c. Claim conflict gate — NT13 fast gate (lease không fencing = lời hứa) ──
# Chỉ chạy khi registry <git-common-dir>/ai-simple/claims tồn tại (tức đang có run song song).
# Rule: staged path ∩ write_paths của claim thuộc BRANCH KHÁC → BLOCK (kể cả STALE —
# không silent takeover; lease-expiry math để cho doctor/CLI, hook chỉ so path cho nhanh).
# Giới hạn nêu tên: path có space không hỗ trợ ở gate sh này — và CLI normPath REJECT
# space/quote/control từ lúc claim (kiểm chứng bằng `parallel self-test`), nên không có
# claim hợp lệ nào chứa path như vậy để lọt.
if [ "$CLAIMS_CHECK" != "off" ]; then
  CDIR="$(git rev-parse --git-common-dir 2>/dev/null)/ai-simple/claims"
  if [ -d "$CDIR" ]; then
    CURBR=$(git symbolic-ref --short -q HEAD)
    for cf in "$CDIR"/*.json; do
      [ -f "$cf" ] || continue
      case "$cf" in *tmp-*|*run-lease--*) continue;; esac
      CBR=$(grep '"branch"' "$cf" | head -1 | sed 's/.*: *"//; s/".*//')
      { [ -n "$CBR" ] && [ "$CBR" != "$CURBR" ]; } || continue
      CPATHS=$(sed -n '/"write_paths"/,/\]/p' "$cf" | grep '^[[:space:]]*"' | grep -v write_paths | sed 's/^[[:space:]]*"//; s/",*$//')
      for p in $CPATHS; do
        if covers_hit "$p"; then
          CLOT=$(grep '"lot"' "$cf" | head -1 | sed 's/.*: *"//; s/".*//')
          echo "BLOCK: staged path trong write-set cua claim khac — '$p' thuoc lot '$CLOT' (branch $CBR)."
          echo "  -> NT13: doi lot kia merge / parallel extend / hoi orchestrator. Xem: npx ai-simple parallel status"
          FAIL=1
        fi
      done
    done
  fi
fi

# ── 1d. UI anti-slop gate (ui-design-logic 07 §5; nguồn: Hallmark gate 48/34) ──
# auto: chỉ chạy khi repo có dấu hiệu UI (tailwind.config.* / globals.css). on/off để ép.
if [ "$UI_CHECKS" != "off" ]; then
  UI_ACTIVE=0
  if [ "$UI_CHECKS" = "on" ]; then UI_ACTIVE=1
  elif ls tailwind.config.* >/dev/null 2>&1 || [ -f src/app/globals.css ] || [ -f app/globals.css ]; then UI_ACTIVE=1; fi
  if [ "$UI_ACTIVE" -eq 1 ]; then
    # Type ramp cho gate text-[...]: doc tu design-system doc trong app-map, dong dang
    #   `type-ramp: 0.75rem 0.875rem 1rem ...` (space/phay deu duoc). Khong khai -> gate tat
    #   (khong doan ramp ho project). Nguon: hoi dong 2026-08-13 — port y tuong rule
    #   design-system-font-size cua Impeccable, tu viet vi don vi code da thong nhat (so chuoi du).
    RAMP=""
    for dsd in $(git ls-files 'docs/app-map/*design-system*.md' 'docs/app-map/*design-spec*.md' 2>/dev/null); do
      R=$(grep -i '^type-ramp:' "$dsd" 2>/dev/null | head -1 | sed 's/^[^:]*:[[:space:]]*//' | tr ',' ' ')
      [ -n "$R" ] && { RAMP="$R"; break; }
    done
    for f in $(echo "$CHANGED" | grep -E '\.(tsx|jsx|css|vue|svelte)$' || true); do
      UC=$(git show ":$f" 2>/dev/null) || continue
      if echo "$UC" | grep -qE '(text|bg|border|from|to|via)-\[#[0-9a-fA-F]'; then
        echo "BLOCK: mau hard-code ngoai token trong $f (vd text-[#...]) — can mau moi thi lift vao theme/globals.css truoc (ui-design-logic 04 §5, Hallmark gate 48)."
        FAIL=1
      fi
      # Mau hard-code dang ham: rgba()/hsla()/hsl()/rgb() trong arbitrary class (shadow-[0_..._rgba(...)],
      # bg-[rgb(...)]...) — lot ca gate hex o tren (neo vao '#'). Do thuc te ForFish: 14 hit rgba vs 1 hex.
      if echo "$UC" | grep -qE '\-\[[^]]*(rgba?|hsla?)\('; then
        echo "BLOCK: mau ham (rgba/hsla) hard-code trong arbitrary class o $f — lift vao token/globals.css (ui-design-logic 04 §5; hoi dong 2026-08-13: kenh lot chinh cua mau ngoai token)."
        FAIL=1
      fi
      # Co chu ngoai type ramp: chi chay khi project DA khai ramp. WARN (se len BLOCK sau khi
      # don not — xem tieu chi dung cua hoi dong). So CHUOI literal — khong quy doi don vi.
      if [ -n "$RAMP" ]; then
        for tv in $(echo "$UC" | grep -oE 'text-\[[0-9.]+(rem|px)\]' | sort -u); do
          v=$(echo "$tv" | sed 's/^text-\[//; s/\]$//')
          echo " $RAMP " | grep -qF " $v " || echo "WARN: co chu '$tv' ngoai type-ramp da khai trong $f — dung bac ramp hoac them bac vao design-system doc kem ly do (ui-design-logic 04 §3)."
        done
      fi
      # ── 1d-e..1d-i: 5 BLOCK noi hoa 2026-08-14 (NOTICE.md; FP do tren ForFish 73 file = 0) ──
      # 1d-e focus ring bi huy trang — soi TUNG DONG: dong co outline-none ma khong co vong thay the
      # v1.20.0 (audit độc lập 2026-08-17, P0): thêm `outline:0` vào phát hiện (trước đây chỉ khớp
      # `outline: none` nên `{outline:0}` lọt), và nới whitelist cho `box-shadow`/`ring-offset` —
      # `.btn:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--focus) }` là focus style HỢP
      # WCAG mà gate cũ BLOCK OAN (không có fixture chống-oan ⇒ vi phạm luật của chính CLAUDE.md).
      # Vẫn soi TỪNG DÒNG: hạ 1 dòng có huỷ mà không có vòng thay thế nào trên cùng dòng.
      BADFOCUS=$(echo "$UC" | grep -nE 'outline-none|outline:[[:space:]]*(none|0)' | grep -vE 'ring-|focus-visible|outline-offset|box-shadow|outline:[[:space:]]*[1-9]' || true)
      if [ -n "$BADFOCUS" ]; then
        echo "BLOCK: huy focus ring khong co vong thay the trong $f — nguoi dung ban phim bi chan hang; dung focus-visible:ring-* (ui-design-logic SKILL [INV], hook 1d-e):"
        echo "$BADFOCUS" | head -3 | sed 's/^/    /'
        FAIL=1
      fi
      # 1d-f onClick tren the khong tuong tac (grep tho 1 dong — JSX xuong dong se lot, lot la an toan)
      if echo "$UC" | grep -E '<(div|span|li|td|tr)[^>]*onClick' | grep -qv 'role='; then
        echo "BLOCK: onClick tren div/span/li/td khong role/tabIndex trong $f — doi sang <button type=\"button\"> (ui-design-logic SKILL [INV], hook 1d-f)."
        FAIL=1
      fi
      # 1d-g gradient tren CHU — doi CA HAI dau hieu (bg-clip-text mot minh co the la mat na anh)
      if echo "$UC" | grep -q 'bg-clip-text' && echo "$UC" | grep -q 'text-transparent'; then
        echo "BLOCK: gradient to len chu trong $f — khong do duoc contrast, lot moi cong mau; nhan bang weight/co/accent dac (04 §1, hook 1d-g)."
        FAIL=1
      fi
      # 1d-h glow = shadow offset 0 moi huong (bat ca kenh var() ma gate mau hex/rgba khong thay)
      if echo "$UC" | grep -qE '(shadow|drop-shadow)-\[0(px|rem)?_0(px|rem)?_'; then
        echo "BLOCK: glow (shadow offset 0) trong $f — bong phai co offset+blur, khong halo trang tri (04 §4, hook 1d-h)."
        FAIL=1
      fi
      # 1d-i tracking am vuot san -0.03em
      if echo "$UC" | grep -qE 'tracking-\[-0\.0[4-9]|tracking-\[-0\.[1-9]'; then
        echo "BLOCK: letter-spacing am vuot san -0.03em trong $f — chu dinh nhau, khong doc duoc (04 §3, hook 1d-i)."
        FAIL=1
      fi
      # P2 (WARN — GOP 1 alternation theo ngan sach thoi gian methodology/08). Tung id:
      # 1d-j transition-all · 1d-k animate layout-prop (width/height/top/left/margin/padding)
      # · 1d-l hover:scale · 1d-m uppercase+leading-none · 1d-n text-[clamp(] · 1d-o border+shadow-lg
      P2=$(echo "$UC" | grep -nE 'transition-all|transition-\[[^]]*(width|height|top|left|margin|padding)|hover:scale-|text-\[clamp\(|uppercase[^"]*leading-none|leading-none[^"]*uppercase|[" ]border[" ][^"]*shadow-(lg|xl|2xl)|shadow-(lg|xl|2xl)[^"]*[" ]border[" ]' || true)
      if [ -n "$P2" ]; then
        echo "WARN: pattern P2 trong $f — transition-all/animate-layout-prop/hover:scale (04 §6) · clamp font trong app (04 §3) · IN HOA+leading-none cat dau tieng Viet (04 §3) · border+shadow-lg 2 lop elevation (04 §4) — hook 1d-j..1d-o:"
        echo "$P2" | head -3 | sed 's/^/    /'
      fi
      case "$f" in
        *globals.css|*token*.css)
          # 1d-p: theme dung cham globals/tokens ma thieu be mat trinh duyet -> WARN (tra no 1 lan la xong)
          MISSB=""
          echo "$UC" | grep -q '::selection' || MISSB="$MISSB ::selection"
          echo "$UC" | grep -q 'caret-color' || MISSB="$MISSB caret-color"
          echo "$UC" | grep -q 'text-underline-offset' || MISSB="$MISSB text-underline-offset"
          [ -n "$MISSB" ] && echo "WARN: $f thieu be mat trinh duyet:$MISSB — theme phai phu ::selection/caret/underline-offset (04 §4b, hook 1d-p)."
          ;;
        *) echo "$UC" | grep -qE 'font-family:' && echo "WARN: font-family trong $f (ngoai globals/tokens) — font song o 1 cho duy nhat (ui-design-logic 07 §5)." ;;
      esac
      echo "$UC" | grep -qE 'overflow-x:[[:space:]]*hidden' && echo "WARN: overflow-x: hidden trong $f — che trieu chung tran ngang thay vi sua; neu buoc phai chan dung 'clip' (Hallmark gate 34)."
    done
  fi
fi

